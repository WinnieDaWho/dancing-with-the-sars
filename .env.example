# Dancing with the SARS — environment template
# Copy to .env and fill in. NEVER commit .env (blocked by .gitignore).

# PostGIS (matches docker-compose.yml defaults; local dev only)
DATABASE_URL=postgresql://dwts:dwts_local_dev@localhost:5433/dwts

# FastAPI
API_PORT=8077

# NASA Earthdata (optional — without it the app serves deterministic seeded
# anomalies with data_mode="simulated" and never crashes)
# Create a token at https://urs.earthdata.nasa.gov/
EARTHDATA_TOKEN=

# gods-eye-view voice agents (optional; set inside gods-eye-view/.env as well)
GEMINI_API_KEY=
OPENAI_API_KEY=
